{
  "name": "figghost-tauri",
  "private": true,
  "version": "2.2.23",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:embed": "tsc --noEmit && node tools/build-embed.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "tauri": "tauri",
    "test": "node --test \"tests/*.test.ts\"",
    "check:embed": "node tools/build-embed.mjs && git diff --exit-code -- ../crates/app-ui/web ../crates/desktop/web"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "0.19.2",
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "acorn": "^8.19.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
