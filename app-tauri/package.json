    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "acorn": "^8.19.0",
